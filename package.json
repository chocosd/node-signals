{
  "name": "@chocosd/node-signals",
  "version": "1.0.0",
  "description": "A tiny reactive signals engine: signals, effects, computed, pipelines, operators, and async sources. Runs in Node and the browser.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "signals",
    "reactive",
    "reactivity",
    "effect",
    "computed",
    "pipeline",
    "node",
    "esm"
  ],
  "license": "ISC",
  "sideEffects": false,
  "devDependencies": {
    "monaco-editor": "^0.52.2",
    "typescript": "6.0.3",
    "vite": "^6.3.5"
  }
}
